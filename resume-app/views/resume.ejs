<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= resume.name %> - CV</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 800px;
            margin: 40px auto;
            padding: 30px;
            line-height: 1.6;
            color: #222;
            background: #f7f8fc;
        }
        main {
            background: white;
            padding: 35px;
            border-radius: 10px;
            box-shadow: 0 3px 15px rgba(0,0,0,.08);
        }
        h1 { color: #4930a8; margin-bottom: 4px; }
        h2 { color: #4930a8; text-transform: capitalize; }
        hr { border: 0; border-top: 1px solid #ddd; margin: 22px 0; }
        ul { padding-left: 22px; }
        @media (max-width: 600px) {
            body { margin: 10px; padding: 10px; }
            main { padding: 20px; }
        }
    </style>
</head>
<body>
<main>
    <h1><%= resume.name %></h1>

    <h2>Contact</h2>
    <p><strong>Address:</strong> <%= resume.contact.address %></p>
    <p><strong>Phone:</strong> <%= resume.contact.phone %></p>
    <p><strong>Email:</strong> <%= resume.contact.email %></p>

    <hr>
    <h2>Objective</h2>
    <p><%= resume.objective %></p>

    <hr>
    <h2>Education</h2>
    <p><strong><%= resume.education.degree %></strong></p>
    <p><%= resume.education.college %></p>
    <p><strong>CGPA:</strong> <%= resume.education.cgpa %></p>

    <hr>
    <h2>Skills</h2>
    <ul>
        <% resume.skills.forEach(function(skill) { %>
            <li><%= skill %></li>
        <% }); %>
    </ul>

    <hr>
    <h2>Internship</h2>
    <p><%= resume.internship %></p>
</main>
</body>
</html>
